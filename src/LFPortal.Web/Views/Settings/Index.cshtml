@model LFPortal.Web.Controllers.SettingsViewModel
@{ ViewData["Title"] = "Settings"; }
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px"><div><h1>⚙️ الإعدادات</h1><p style="color:var(--lfp-muted)">إعدادات العرض المحلية — Demo Mode</p></div><span class="badge badge--green">Demo Connected</span></div>
@if (Model.SaveSuccess) { <div class="alert alert--success" style="margin-bottom:16px">✓ تم حفظ تفضيلات العرض محلياً لهذه النسخة التجريبية.</div> }
<div class="card">
  <div class="card__title">إعدادات النسخة التجريبية</div>
  <form asp-action="Save" method="post">@Html.AntiForgeryToken()
    <div class="settings-grid">
      <div class="field-group"><label class="field-label">Server</label><input class="field-input" value="Demo Server" readonly></div>
      <div class="field-group"><label class="field-label">Repository</label><input class="field-input" value="TestEmployee" readonly></div>
      <div class="field-group"><label class="field-label">API Status</label><input class="field-input" value="Disabled — Mock Data" readonly></div>
      <div class="field-group"><label class="field-label">Authentication Mode</label><input class="field-input" value="Demo Mode" readonly></div>
      <div class="field-group"><label class="field-label">Language</label><select class="field-input"><option>Arabic / English</option></select></div>
      <div class="field-group"><label class="field-label">Theme</label><select class="field-input"><option>Dark</option></select></div>
      <div class="field-group"><label class="field-label">Read-only mode</label><input class="field-input" value="Enabled" readonly></div>
    </div>
    <div style="margin-top:22px"><button class="btn btn--primary" type="submit">حفظ إعدادات العرض</button></div>
  </form>
</div>
<div class="alert alert--info" style="margin-top:16px">جميع البيانات وهمية. لا تُحفظ بيانات اعتماد ولا يتم اختبار أي خادم أو واجهة API.</div>
